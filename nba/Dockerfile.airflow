# Dockerfile para Airflow con Kedro instalado
FROM apache/airflow:2.7.0

# Cambiar a usuario root para instalar paquetes
USER root

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Volver al usuario airflow
USER airflow

# Instalar Kedro y dependencias del proyecto
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Instalar DVC si es necesario
RUN pip install dvc[s3]

# Crear directorios necesarios
RUN mkdir -p /opt/airflow/data/01_raw \
    /opt/airflow/data/02_intermediate \
    /opt/airflow/data/03_primary \
    /opt/airflow/data/04_feature \
    /opt/airflow/data/05_model_input \
    /opt/airflow/data/06_models \
    /opt/airflow/data/07_model_output \
    /opt/airflow/data/08_reporting \
    /opt/airflow/data/metrics \
    /opt/airflow/data/plots

# Establecer el directorio de trabajo
WORKDIR /opt/airflow

